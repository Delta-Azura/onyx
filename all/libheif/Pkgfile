description=" The libheif package is an HEIF and AVIF file format decoder and encoder. "
name=libheif
version=1.22.2
release=1
packager=alexis
source=("https://github.com/strukturag/libheif/releases/download/v${version}/libheif-${version}.tar.gz")

build() {
cd $name-$version
mkdir build &&
cd    build &&

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D WITH_GDK_PIXBUF=OFF       \
      -D WITH_OpenH264_DECODER=OFF \
      -G Ninja ..                  &&
ninja
DESTDIR=$PKG ninja install
}
