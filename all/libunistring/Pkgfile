description=" libunistring is a library that provides functions for manipulating Unicode strings and for manipulating C strings according to the Unicode standard. "
name=libunistring
version=1.4.2
release=1
packager=alexis
source=("https://ftpmirror.gnu.org/libunistring/libunistring-${version}.tar.xz")

build() {
cd $name-$version
sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&)/' \
    -i $(find -name \*.in.h)
./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/libunistring-${version} &&
make
make DESTDIR=$PKG install
}
