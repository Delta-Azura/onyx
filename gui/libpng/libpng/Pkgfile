description="The libpng package contains libraries used by other programs for reading and writing PNG files."
name=libpng
version=1.6.58
release=1
packager=alexis
depends="htop"
source=("https://github.com/pnggroup/libpng/archive/refs/tags/v1.6.58.tar.gz"
"libpng-${version}-apng.patch.gz")


build() {
cd $name-$version
zcat ../libpng-${version}-apng.patch.gz | patch -p1
./configure --prefix=/usr --disable-static 
make
make DESTDIR=$PKG install
mkdir -pv $PKG/usr/share/doc/libpng-${version}
cp -v README libpng-manual.txt $PKG/usr/share/doc/libpng-${version}
mkdir -p $PKG/var/cache/
touch $PKG/var/cache/tasalopedemere

}
