makedepends=(llvm cmake git)

description="Linker from the LLVM project"
url="https://lld.llvm.org/"

packager="Great-OS Team"
maintainer="Great-OS Team"

name=lld
version=22.1.5
release=1

source=("https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz")

build() {

  mkdir -pv build && cd build

  cmake ../llvm-project-${version}.src/lld -G Ninja \
           -DCMAKE_BUILD_TYPE=Release \
           -DCMAKE_INSTALL_PREFIX=/usr \
           -DCMAKE_SKIP_RPATH=ON \
           -DBUILD_SHARED_LIBS=ON \
           -DLLVM_LINK_LLVM_DYLIB=ON \
           -DLLVM_INCLUDE_TESTS=OFF \
           -DLLVM_BUILD_TESTS=OFF \
           -DLLVM_ENABLE_SPHINX=OFF \
           -DLLVM_EXTERNAL_LIT=/usr/bin/lit \
           -DLLVM_MAIN_SRC_DIR="../llvm-project-$version.src/llvm"

  ninja

  DESTDIR="${PKG}" ninja install
}
